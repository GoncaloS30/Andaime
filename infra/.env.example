POSTGRES_PASSWORD=postgres_local
ANDAIME_DATABASE_OWNER_PASSWORD=andaime_owner_local
ANDAIME_DATABASE_PASSWORD=andaime_app_local

# Semente de demonstração (só desenvolvimento; nunca em produção). Conta local fictícia.
ANDAIME_SEED_DEMO_OWNER_EMAIL=demo@andaime.test
ANDAIME_SEED_DEMO_OWNER_PASSWORD=demo-local-andaime-2026

# Armazenamento S3 de documentos (SeaweedFS local; em produção, as credenciais vêm sempre do ambiente).
ANDAIME_STORAGE_ENDPOINT=http://localhost:59010
ANDAIME_STORAGE_ACCESS_KEY=andaime-local
ANDAIME_STORAGE_SECRET_KEY=andaime-local-secret
# Antivírus: "clamd" com o serviço clamav do Compose (perfil antivirus); "off" não analisa os uploads.
ANDAIME_ANTIVIRUS_MODE=off
