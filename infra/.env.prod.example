# Variáveis de produção do Andaime para infra/compose.prod.yaml.
#
#   cp infra/.env.prod.example infra/.env.prod && chmod 600 infra/.env.prod
#
# O infra/.env.prod está no .gitignore: NUNCA o commitar. Todos os valores abaixo são marcadores; substituir por
# segredos gerados (ex.: openssl rand -base64 36 | tr -d '/+=' ) e guardá-los também num gestor de palavras-passe.
# Sem aspas à volta dos valores. Evitar o carácter $ nas palavras-passe (o Compose interpreta-o).

# --- Versão das imagens (tag que se constrói/usa; permite voltar à anterior num rollback) ---
ANDAIME_VERSION=3.1.0

# --- Endereço público (sem / no fim): usado nos links dos emails ---
ANDAIME_PUBLIC_URL=https://app.exemplo.pt

# --- Porta HTTP do nginx na VM (o TLS termina à frente) ---
# 127.0.0.1 quando o Caddy/proxy corre na mesma VM; IP privado da VM (ou 0.0.0.0 com firewall) atrás de um balanceador.
ANDAIME_HTTP_BIND=127.0.0.1
ANDAIME_HTTP_PORT=8080

# --- PostgreSQL ---
# Superutilizador do contentor (só operação: backups, criar o primeiro administrador da plataforma).
POSTGRES_PASSWORD=substituir-superutilizador-postgres
# andaime_owner: dono do esquema, usado só pelo Flyway no arranque do backend.
ANDAIME_DATABASE_OWNER_PASSWORD=substituir-andaime-owner
# andaime_app: pool da aplicação (sujeito a RLS).
ANDAIME_DATABASE_PASSWORD=substituir-andaime-app
# andaime_platform: consola da plataforma (lista/suspende organizações).
ANDAIME_PLATFORM_DATABASE_PASSWORD=substituir-andaime-platform
# Só com PostgreSQL gerido (em vez do contentor): URL JDBC com TLS, ex.
# ANDAIME_DATABASE_URL=jdbc:postgresql://db.exemplo.internal:5432/andaime?sslmode=verify-full
# NOTA: as palavras-passe dos papéis só são aplicadas na PRIMEIRA inicialização do volume. Para as mudar depois:
#   ALTER ROLE andaime_app PASSWORD '…';  (como postgres) e atualizar este ficheiro.

# --- Email transacional (SMTP, porta 587 com STARTTLS) ---
ANDAIME_MAIL_HOST=smtp.fornecedor-email.exemplo
ANDAIME_MAIL_PORT=587
ANDAIME_MAIL_USERNAME=substituir-utilizador-smtp
ANDAIME_MAIL_PASSWORD=substituir-palavra-passe-smtp
# Remetente (cabeçalho From) verificado no fornecedor (domínio com SPF, DKIM e DMARC).
ANDAIME_MAIL_FROM=Andaime <nao-responder@exemplo.pt>
# true em produção; false só num ensaio local com um SMTP sem TLS.
ANDAIME_MAIL_STARTTLS=true

# --- Armazenamento de documentos (S3 gerido, bucket privado, na UE) ---
ANDAIME_STORAGE_ENDPOINT=https://s3.eu-central-1.fornecedor.exemplo
ANDAIME_STORAGE_REGION=eu-central-1
ANDAIME_STORAGE_BUCKET=andaime-documentos
# Chave com acesso SÓ a este bucket (ler, escrever, apagar objetos).
ANDAIME_STORAGE_ACCESS_KEY=substituir-chave-de-acesso
ANDAIME_STORAGE_SECRET_KEY=substituir-chave-secreta

# --- Antivírus (ClamAV do Compose). "clamd" em produção; "off" desliga a análise (não recomendado) ---
ANDAIME_ANTIVIRUS_MODE=clamd
ANDAIME_ANTIVIRUS_HOST=clamav
ANDAIME_ANTIVIRUS_PORT=3310
ANDAIME_ANTIVIRUS_TIMEOUT_MS=30000

# --- Sessão: cookie Secure. Sempre true em produção (false só num ensaio local sem HTTPS) ---
ANDAIME_COOKIE_SECURE=true

# --- 2FA (TOTP): chave de cifra dos segredos TOTP; introduzida pela funcionalidade de 2FA ---
# Gerar uma vez com: openssl rand -base64 32   (perdê-la obriga todos os utilizadores a reconfigurar o 2FA)
ANDAIME_TOTP_KEY=substituir-chave-totp-base64

# --- JVM (opcional) ---
# ANDAIME_JAVA_OPTS=-XX:+ExitOnOutOfMemoryError

# --- Caddy (só com --profile caddy): domínio servido e email para o Let's Encrypt ---
ANDAIME_DOMAIN=app.exemplo.pt
ANDAIME_ACME_EMAIL=operacao@exemplo.pt
